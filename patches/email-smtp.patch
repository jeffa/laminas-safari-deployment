diff --git a/module/Application/src/Model/ModelPhpMailer.php b/module/Application/src/Model/ModelPhpMailer.php
--- a/module/Application/src/Model/ModelPhpMailer.php
+++ b/module/Application/src/Model/ModelPhpMailer.php
@@ -491,7 +491,19 @@
-        $transport->Host       = EMAIL_SERVER_NAME;              //Set the SMTP server to send through
+        $serverHost = defined('EMAIL_SERVER_HOST') && EMAIL_SERVER_HOST !== ''
+            ? EMAIL_SERVER_HOST
+            : EMAIL_SERVER_NAME;
+        $serverPort = defined('EMAIL_SERVER_PORT') && EMAIL_SERVER_PORT !== ''
+            ? (int) EMAIL_SERVER_PORT
+            : 465;
+        $serverEncryption = defined('EMAIL_SERVER_ENCRYPTION')
+            ? strtolower((string) EMAIL_SERVER_ENCRYPTION)
+            : 'ssl';
+
+        $transport->Host       = $serverHost;                    //Set the SMTP server to send through
         $transport->SMTPAuth   = true;                           //Enable SMTP authentication
         $transport->Username   = $this->userName;                //SMTP username
         $transport->Password   = $this->password;                //SMTP password
-        $transport->SMTPSecure = PHPMailer::ENCRYPTION_SMTPS;    //Enable implicit TLS encryption
-        $transport->Port       = 25;                             //TCP port to connect to; use 587 if you have set `SMTPSecure = PHPMailer::ENCRYPTION_STARTTLS`
+        $transport->SMTPSecure = in_array($serverEncryption, ['tls', 'starttls'], true)
+            ? PHPMailer::ENCRYPTION_STARTTLS
+            : PHPMailer::ENCRYPTION_SMTPS;
+        $transport->Port       = $serverPort;

